{
  "integrationBranch": "main",
  "highRisk": [
    "plugins/core/scripts/**",
    "plugins/verify/scripts/**",
    "install.sh",
    ".claude/verify.json"
  ],
  "tests": {
    "all": "npm test",
    "byName": "node --test --test-name-pattern \"\\{name}\" \"tests/*.test.mjs\" \"plugins/*/tests/*.test.mjs\"",
    "acceptance": [
      "plugins/verify/tests/spec-compliance.test.mjs",
      "plugins/verify/tests/guard-scenarios.test.mjs",
      "plugins/verify/tests/carried-over-scenarios.test.mjs",
      "plugins/verify/tests/fixtures/compliance/**",
      "plugins/verify/tests/gate-reasons.test.mjs",
      "plugins/verify/tests/gate-apply.test.mjs",
      "plugins/verify/tests/evidence-publish.test.mjs",
      "plugins/verify/tests/review-follow-up.test.mjs"
    ],
    "exclude": [
      "plugins/verify/tests/fixtures/compliance/**",
      "plugins/verify/tests/gate-holds.test.mjs",
      "plugins/verify/tests/gate.test.mjs"
    ],
    "alwaysAllowed": [
      "openspec/**",
      "docs/**",
      "*.md",
      ".claude/**"
    ]
  },
  "gate": {
    "reviews": "highRisk"
  }
}
